# Robinhood Chain JSON-RPC. The public endpoint is rate-limited.
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Morpho Blue GraphQL. Positions and APYs come from here.
VITE_MORPHO_GRAPHQL=https://api.morpho.org/graphql

# Poll interval in seconds (minimum 15).
VITE_POLL_SECONDS=45

# Optional. 0x / Matcha Swap API key (https://dashboard.0x.org).
# Chain 4663 is supported, but the price endpoint returns 401 without a key.
# When set, each size is quoted on both KyberSwap and 0x and the better USDG out wins.
# The key is inlined into the static bundle. Use a referrer-restricted key. Do not commit it.
# On Railway these are build-time values. Set them on the service, then redeploy.
# A runtime-only change does not update the bundle.
# ZEROX_API_KEY=
# VITE_ZEROX_API_KEY=

# Optional. Server-only Nansen key for the holder and flow panel (/api/nansen).
# Read at runtime by server.mjs and the Vite dev server. Never inlined into the bundle.
# NANSEN_API_KEY=
# One Nansen read (9 calls) is cached this many minutes. 10-720.
# Bond buyer labels (/api/bonds) use the same interval, about one call per read.
# NANSEN_TTL_MINUTES=60

# Server-only bond index (/api/bonds). Reads BondDepository logs from the public RPC.
# Chain reads refresh at most once per this many seconds. 30-600.
# BONDS_TTL_SECONDS=60
# The index is saved here. Without it, the first build takes about 20 minutes (RPC rate limits).
# On Railway, point this at a mounted volume to keep it across deploys.
# BONDS_CACHE_FILE=.cache/bonds.json
